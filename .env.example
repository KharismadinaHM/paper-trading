# Database Configuration
# Catatan: Jika menggunakan docker-compose.prod.yml, DATABASE_URL otomatis disesuaikan
# ke internal network container ('postgres:5432').
# Untuk akses langsung dari host VM / CLI lokal:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paper_trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=paper_trading
POSTGRES_PORT=5432

# Paper Trading Risk & Slippage Configuration
SLIPPAGE_BPS=0
SPREAD_BPS=0
# Fee dari profit pemenang saat settlement (bps)
FEE_RATE_BPS=0
# Maksimum ukuran satu order (USD)
MAX_POSITION_SIZE=1.00
# Maksimum akumulasi cost basis posisi terbuka per market & seluruh akun (USD)
MAX_EXPOSURE_PER_MARKET=1.00
MAX_TOTAL_EXPOSURE=10.00
# Minimum nilai proceeds order jual (USD)
MIN_ORDER_NOTIONAL=0.01
INITIAL_BALANCE=20.00
# Tolak order jika snapshot harga lebih tua dari 3x COLLECTOR_INTERVAL_SECONDS
REJECT_STALE_ORDERS=true

# Rekomendasi market suhu berbasis jam puncak lokal tiap kota (tanpa filter harga)
# Jam puncak per kota = solar noon / matahari terbit + lag hasil riset (app/paper_trading/peak_calibration.json,
# lihat docs/PEAK_HOURS_RESEARCH.md). Jendela rekomendasi = [awal puncak - LEAD - WINDOW, awal puncak - LEAD)
TEMP_PEAK_DURATION_HOURS=1
RECOMMENDATION_LEAD_HOURS=1
RECOMMENDATION_WINDOW_HOURS=1
# Jenis market yang direkomendasikan: highest, lowest, atau highest,lowest
RECOMMENDATION_KINDS=highest,lowest
# Bracket dianggap likuid jika spread order book (ask − bid) ≤ nilai ini; yang tidak likuid dilewati
RECOMMENDATION_MAX_SPREAD=0.10
# Opsional (JSON): koreksi AWAL jam puncak lokal per kota & zona waktu kota baru
# TEMP_PEAK_HOUR_OVERRIDES={"Hong Kong": {"highest": 14, "lowest": 6}}
# CITY_TIMEZONE_OVERRIDES={"Lima": "America/Lima"}
TEMP_PEAK_HOUR_OVERRIDES=
CITY_TIMEZONE_OVERRIDES=

# Dashboard Authentication (HTTP Basic)
# WAJIB diisi jika dashboard dapat diakses dari internet (mis. port 8000 di GCP).
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Kirim daftar rekomendasi saat kota masuk jendela menjelang jam puncak suhu
TELEGRAM_RECOMMENDATION_ALERTS=true
# Hanya N kota dengan volume market suhu terbesar yang dikirim ke Telegram (0 = semua kota)
TELEGRAM_RECOMMENDATION_TOP_CITIES=7
# Alert lonjakan suhu Hong Kong (HKO per 10 menit): naik >= SPIKE °C dalam WINDOW menit, atau max
# hari ini menembus derajat bulat baru. Jeda antar alert lonjakan = COOLDOWN menit.
HKO_ALERTS=true
HKO_ALERT_SPIKE_DEGREES=0.8
HKO_ALERT_WINDOW_MINUTES=30
HKO_ALERT_COOLDOWN_MINUTES=30
HKO_ALERT_HOURS=7-19
# Max HK tidak dianggap final sebelum jam ini (HKT) kecuali suhu sudah turun >= HKO_FINAL_DROP dari max
HKO_FINAL_HOUR=17
HKO_FINAL_DROP=1.0
# Proyeksi /hk jam: sisa bias (HKO - model) pada jam ke-6 (1.0 = tanpa peluruhan)
HKO_BIAS_DECAY_AT_6H=0.5
# Alert "mendekati derajat berikutnya" saat max >= X + fraksi ini (mis. 33.7 menuju 34)
HKO_NEAR_DEGREE_FRACTION=0.7

# "Waspada berbalik": alert saat bracket favorit >= REVERSAL_MIN_PRICE tetapi suhu mendekati batas bracket,
# bracket sebelah melonjak >= REVERSAL_MOMENTUM dalam 30 menit, atau data stasiun sudah melewati bracket
REVERSAL_ALERTS=true
REVERSAL_MIN_PRICE=0.90
REVERSAL_MOMENTUM=0.08
# Waspada berbalik hanya untuk market volume besar & likuid; konfirmasi bila favorit jatuh < REVERSAL_CONFIRM_PRICE
REVERSAL_MIN_VOLUME=20000
REVERSAL_MAX_SPREAD=0.03
REVERSAL_MIN_DEPTH_USD=100
REVERSAL_CONFIRM_PRICE=0.50

# Wallet tracker Polymarket: rekomendasi dari leaderboard kategori ini, win rate/PnL N hari,
# alert transaksi wallet yang diikuti (dicek tiap WALLET_POLL_SECONDS, minimal WALLET_ALERT_MIN_USDC)
WALLET_STATS_DAYS=30
WALLET_DISCOVERY_CATEGORY=WEATHER
WALLET_DISCOVERY_CANDIDATES=12
WALLET_DISCOVERY_MIN_RESOLVED=15
WALLET_DISCOVERY_REFRESH_HOURS=6
WALLET_ALERTS=true
WALLET_POLL_SECONDS=60
WALLET_ALERT_MIN_USDC=5
WALLET_ALERT_WEATHER_ONLY=false
# Anti-spam alert wallet: sekali per market per hari, maks 1 pesan per wallet tiap N menit
WALLET_ALERT_COOLDOWN_MINUTES=60
# Alert saat porto sendiri & wallet yang diikuti memegang market yang sama (cek tiap N menit)
WALLET_OVERLAP_ALERTS=true
WALLET_OVERLAP_CHECK_MINUTES=10
# Insider wallet: scan taruhan besar berpola orang dalam tiap N menit, skor 0-15
INSIDER_ENABLED=true
INSIDER_ALERTS=true
INSIDER_SCAN_MINUTES=5
INSIDER_MIN_TRADE_USD=1000
INSIDER_MIN_BET_USD=2000
INSIDER_MAX_PRICE=0.50
INSIDER_MIN_SCORE=7
INSIDER_EXCLUDE_SPORTS=true

# Portfolio Polymarket sendiri (READ-ONLY): alamat wallet dari profil Polymarket (polymarket.com/profile/0x…)
POLYMARKET_WALLET_ADDRESS=
# Opsional: API key CLOB untuk saldo cash & open order (hanya request baca). JANGAN isi private key.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# Alamat yang membuat API key (biasanya alamat signer/EOA); kosong = POLYMARKET_WALLET_ADDRESS
POLYMARKET_SIGNER_ADDRESS=
# 1 = akun email/Magic, 2 = browser wallet (MetaMask dll.), 0 = EOA
POLYMARKET_SIGNATURE_TYPE=1

# Auto paper trader (PAPER saja). Status awal; ubah kapan saja lewat Telegram /startbot /stopbot.
AUTOTRADE_ENABLED=false
AUTOTRADE_STRATEGIES=weather,weather_post,btc,maker_btc
# Strategi BTC 5 menit (btc5, maker_btc5): jendela masuk menit ke- dalam rentang 5 menit
AUTOTRADE_BTC5_WINDOW=2-4
AUTOTRADE_MAKER5_WINDOW=1-4
# Simulasi slippage eksekusi nyata per share (0.01 = 1¢)
AUTOTRADE_SLIPPAGE=0.01
AUTOTRADE_ORDER_USD=5
AUTOTRADE_MAX_DAILY_USD=50
AUTOTRADE_MAX_DAILY_LOSS=20
AUTOTRADE_MAX_OPEN_USD=100
AUTOTRADE_MAX_PRICE=0.90
AUTOTRADE_MAX_SPREAD=0.05
AUTOTRADE_FEE_RATE=0.07
AUTOTRADE_BTC_MIN_EDGE=0.05
# Harga beli minimum sisi BTC (taker & maker); underdog murah di bawah ini dilewati
AUTOTRADE_BTC_MIN_PRICE=0.30
AUTOTRADE_BTC_WINDOW=30-57
AUTOTRADE_BTC15_WINDOW=7-14
AUTOTRADE_MAKER_WINDOW=15-50
AUTOTRADE_MAKER15_WINDOW=3-12
AUTOTRADE_MAKER_MARGIN=0.04
AUTOTRADE_MAKER_MIN_EDGE=0.04
AUTOTRADE_POLL_SECONDS=10
AUTOTRADE_WEATHER_MIN_EDGE=0.05
AUTOTRADE_WEATHER_REQUIRE_AGREEMENT=true
AUTOTRADE_WEATHER_SIGMA_C=0.6
AUTOTRADE_WEATHER_POST_HOURS=3
AUTOTRADE_REPORT_HOUR=21
# Chat/grup Telegram terpisah untuk notifikasi auto trade (kosong = chat utama)
TELEGRAM_AUTOTRADE_CHAT_ID=

# --- Trading UANG ASLI (lihat docs/LIVE_TRADING.md). Mati secara default. ---
# Pakai wallet Polymarket KHUSUS bot berisi dana terbatas, bukan wallet utama. Jangan pernah commit nilai asli.
LIVE_TRADING=false
LIVE_STRATEGIES=btc,eth
LIVE_ORDER_USD=1
LIVE_MAX_ORDER_USD=25
LIVE_MAX_DAILY_USD=10
LIVE_MAX_DAILY_LOSS=5
LIVE_MAX_OPEN_USD=5
LIVE_MAX_SLIPPAGE=0.02
# Harga beli minimum khusus live (terpisah dari harga minimum paper)
LIVE_MIN_PRICE=0.30
LIVE_DRY_RUN=false
POLY_PRIVATE_KEY=
POLY_FUNDER_ADDRESS=
# 0 = wallet EOA/MetaMask langsung, 1 = akun email/Magic, 2 = browser wallet (proxy)
POLY_SIGNATURE_TYPE=1
# Auto-claim kemenangan lewat Relayer (gasless). Kredensial Builder API: Polymarket → Settings → Builder.
LIVE_AUTO_CLAIM=true
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=
# Zona waktu jam di notifikasi
NOTIFY_TIMEZONE=Asia/Jakarta
NOTIFY_TIMEZONE_LABEL=WIB

# Market Collector Configuration
COLLECTOR_INTERVAL_SECONDS=300
GAMMA_API_BASE_URL=https://gamma-api.polymarket.com
# Kategori market yang dikumpulkan & ditampilkan (lihat app/market_collector/categories.py)
ENABLED_MARKET_CATEGORIES=weather,elon_tweets
# Tag Gamma API event cuaca yang dikumpulkan (dipisah koma) & batas halaman (x100 event) per tag
WEATHER_TAG_IDS=84,103040,104596
# Tag "Tweet Markets" (difilter ke event berjudul "Elon")
ELON_TWEETS_TAG_IDS=972
COLLECTOR_MAX_PAGES=10
# Hapus snapshot pasar lebih tua dari N hari (snapshot terbaru tiap market selalu disimpan). 0 = nonaktif
SNAPSHOT_RETENTION_DAYS=30
# Histori harga (market_snapshots) hanya ditulis saat harga/status berubah, atau minimal setiap N detik
SNAPSHOT_HEARTBEAT_SECONDS=3600
# Hanya untuk demo lokal: isi tabel market dengan market SINTETIS jika Gamma API gagal.
# Jangan aktifkan di produksi.
ALLOW_SYNTHETIC_MARKETS=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
# production = fail-fast jika password database default atau DASHBOARD_PASSWORD kosong
APP_ENV=development

